{
  "id": "mmrpg",
  "title": "Marvel Multiverse RPG (não oficial)",
  "description": "Sistema não oficial e em português do Brasil de Marvel Multiverse RPG para Foundry VTT. Ficha completa de personagem e NPC, poderes, traits, tags, origens, ocupações, armas, itens, formas (armaduras, formas alternativas e transformações) e rolagem d616. Não inclui conteúdo dos livros.",
  "authors": [
    {
      "name": "Comunidade (base: mjording / Rollbones Projects)"
    }
  ],
  "url": "https://github.com/Sennaorevoltado/mmrpg",
  "license": "LICENSE",
  "readme": "README.md",
  "version": "1.1.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "esmodules": [
    "mmrpg.mjs"
  ],
  "styles": [
    "css/mmrpg.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
      "npc": {}
    },
    "Item": {
      "item": {},
      "weapon": {},
      "trait": {},
      "tag": {},
      "origin": {},
      "occupation": {},
      "power": {},
      "form": {}
    }
  },
  "socket": true,
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "health",
  "secondaryTokenAttribute": "focus"
}
