{
  "id": "mmrpg",
  "title": "Marvel Multiverse RPG (não oficial)",
  "description": "Sistema não oficial de Marvel Multiverse RPG para Foundry VTT (v14; v13 experimental). Não inclui conteúdo dos livros: importe o seu próprio.",
  "version": "0.3.1",
  "compatibility": {
    "minimum": "13"
  },
  "authors": [
    {
      "name": "Comunidade"
    }
  ],
  "license": "MIT",
  "esmodules": [
    "module/mmrpg.mjs"
  ],
  "styles": [
    "styles/mmrpg.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
