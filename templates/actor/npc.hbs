<div class="mmrpg-sheet npc">
  {{> "systems/mmrpg/templates/actor/parts/header.hbs"}}

  {{> "systems/mmrpg/templates/actor/parts/tabs.hbs"}}

  <div class="mmrpg-panels">
    <section class="mmrpg-panel" data-tab="main">
      <div class="mm-main-grid">
        {{> "systems/mmrpg/templates/actor/parts/damage.hbs"}}
        {{> "systems/mmrpg/templates/actor/parts/abilities.hbs"}}
      </div>
    </section>

    <section class="mmrpg-panel" data-tab="powers">
      {{> "systems/mmrpg/templates/actor/parts/powers.hbs"}}
    </section>

    <section class="mmrpg-panel" data-tab="traits">
      <div class="mm-panel">
        <h3>{{localize "MMRPG.Tabs.traits"}}</h3>
        <div class="mm-panel-body">
          {{> "systems/mmrpg/templates/actor/parts/items.hbs" list=traits type="trait" title=(localize "MMRPG.Sheet.traits") showEquip=false}}
          {{> "systems/mmrpg/templates/actor/parts/items.hbs" list=tags type="tag" title=(localize "MMRPG.Sheet.tags") showEquip=false}}
        </div>
      </div>
    </section>

    <section class="mmrpg-panel" data-tab="gear">
      {{> "systems/mmrpg/templates/actor/parts/gear.hbs"}}
    </section>

    <section class="mmrpg-panel" data-tab="forms">
      {{> "systems/mmrpg/templates/actor/parts/forms.hbs"}}
    </section>

    <section class="mmrpg-panel" data-tab="effects">
      {{> "systems/mmrpg/templates/actor/parts/effects.hbs"}}
    </section>

    <section class="mmrpg-panel" data-tab="mods">
      <div class="mm-panel">
        <h3>{{localize "MMRPG.Tabs.mods"}}</h3>
        <div class="mm-panel-body">{{> "systems/mmrpg/templates/actor/parts/modifiers.hbs"}}</div>
      </div>
      <div class="mm-panel">
        <h3>{{localize "MMRPG.Sheet.movement"}}</h3>
        <div class="mm-panel-body">{{> "systems/mmrpg/templates/actor/parts/movement.hbs"}}</div>
      </div>
    </section>

    <section class="mmrpg-panel" data-tab="notes">
      <div class="mm-panel">
        <h3>{{localize "MMRPG.Tabs.notes"}}</h3>
        <div class="mm-panel-body">
          <h4 class="mm-sub">{{localize "MMRPG.Sheet.notes"}}</h4>
          <prose-mirror name="system.notes" value="{{source.notes}}" toggled>{{{enriched.notes}}}</prose-mirror>
          <h4 class="mm-sub">{{localize "MMRPG.Sheet.biography"}}</h4>
          <prose-mirror name="system.biography" value="{{source.biography}}" toggled>{{{enriched.biography}}}</prose-mirror>
        </div>
      </div>
    </section>
  </div>
</div>
