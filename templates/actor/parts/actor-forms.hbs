{{#unless hasForms}}
  <p class="mm-empty">{{localize "MARVEL_MULTIVERSE.Form.None"}}</p>
{{/unless}}
{{#each formGroups as |group|}}
  <ol class="mm-item-list mm-form-list" data-form-kind="{{group.kind}}">
    <li class="flexrow item mm-item-header">
      <span>{{group.label}}</span>
      <hr />
      <div class="item-controls">
        <a class="item-control item-create" title="{{localize 'MARVEL_MULTIVERSE.Sheet.Create'}}" data-type="form" data-kind="{{group.kind}}">
          <i class="fas fa-plus"></i>
        </a>
      </div>
    </li>
    {{#each group.items as |item|}}
      <li class="flexrow item mm-item{{#if item.system.active}} -active{{/if}}" data-item-id="{{item._id}}">
        <div class="item-name mm-item-name">
          <a class="rollable" data-roll-type="item" data-tooltip="{{localize 'MARVEL_MULTIVERSE.Form.Toggle'}}">
            <span>{{item.name}}</span>
            {{#if item.summary}}<span>{{item.summary}}</span>{{/if}}
          </a>
        </div>
        {{#if item.system.active}}<span class="mm-badge">{{localize "MARVEL_MULTIVERSE.Form.Active"}}</span>{{/if}}
        <div class="item-controls">
          {{#if item.system.active}}
            <a class="item-control form-toggle" title="{{localize 'MARVEL_MULTIVERSE.Form.TurnOff'}}">
              <i class="fas fa-toggle-on"></i>
            </a>
          {{else}}
            <a class="item-control form-toggle" title="{{localize 'MARVEL_MULTIVERSE.Form.TurnOn'}}">
              <i class="fas fa-toggle-off"></i>
            </a>
          {{/if}}
          <a class="item-control item-edit" title="{{localize 'MARVEL_MULTIVERSE.Sheet.Edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a class="item-control item-delete" title="{{localize 'MARVEL_MULTIVERSE.Sheet.Delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
    {{/each}}
  </ol>
{{/each}}
