{{!-- Atalho para criar um poder em qualquer conjunto --}}
<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>{{localize "MARVEL_MULTIVERSE.Sheet.AddPower"}}</span>
    <hr />
    <div class="item-controls">
      <a class="item-control item-create" title="{{localize 'MARVEL_MULTIVERSE.Sheet.AddPower'}}" data-type="power" data-power-set="Basic">
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
</ol>
{{#unless powerGroups.length}}
  <p class="mm-empty">{{localize "MARVEL_MULTIVERSE.Sheet.NoPowers"}}</p>
{{/unless}}
{{#each powerGroups as |group|}}
  <ol class="mm-item-list">
    <li class="flexrow item mm-item-header">
      <span>{{group.name}}</span>
      <hr />
      <div class="item-controls">
        <a class="item-control item-create" title="{{localize 'MARVEL_MULTIVERSE.Sheet.AddPower'}}" data-type="power" data-power-set="{{group.label}}">
          <i class="fas fa-plus"></i>
        </a>
      </div>
    </li>
    {{#each group.items as |item|}}
      <li class="flexrow item mm-item" data-item-id="{{item._id}}">
        <div class="item-name mm-item-name">
          <a class="rollable" data-roll-type="item" data-tooltip="{{localize 'MARVEL_MULTIVERSE.Sheet.UseItem'}}">
            <span>{{item.name}}</span>
            {{#if item.system.cost}}
              <span>{{localize "MARVEL_MULTIVERSE.Item.Field.cost"}}: {{item.system.cost}}</span>
            {{/if}}
          </a>
        </div>
        <div class="item-controls">
          <a class="item-control item-edit" title="{{localize 'MARVEL_MULTIVERSE.Sheet.Edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a class="item-control item-delete" title="{{localize 'MARVEL_MULTIVERSE.Sheet.Delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
    {{/each}}
  </ol>
{{/each}}
