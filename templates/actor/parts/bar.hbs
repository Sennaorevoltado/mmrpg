<header class="mmrpg-sheet mm-bar">
  <div class="mm-id">
    <button type="button" class="mm-portrait" data-action="editImage" data-edit="img" title="{{localize 'MMRPG.Sheet.changeImage'}}" {{#unless editable}}disabled{{/unless}}>
      <img src="{{actor.img}}" alt="">
    </button>
    <div class="mm-names">
      <input class="mm-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'MMRPG.Sheet.codename'}}" aria-label="{{localize 'MMRPG.Sheet.codename'}}" {{#unless editable}}disabled{{/unless}}>
      <input class="mm-real" type="text" name="system.details.realName" value="{{system.details.realName}}" placeholder="{{localize 'MMRPG.Sheet.realName'}}" aria-label="{{localize 'MMRPG.Sheet.realName'}}" {{#unless editable}}disabled{{/unless}}>
    </div>
    <label class="mm-rank">
      <span>{{localize "MMRPG.Sheet.rank"}}</span>
      <select name="system.rank" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions rankOptions system.rank}}</select>
    </label>
  </div>

  <div class="mm-stats">
    <ul class="mm-chips" aria-label="{{localize 'MMRPG.Sheet.abilities'}}">
      {{#each abilities}}
        <li class="mm-chip{{#if overCap}} is-over{{/if}}" title="{{label}}"><abbr>{{abbr}}</abbr><b>{{value}}</b></li>
      {{/each}}
    </ul>
    <div class="mm-vitals">
      {{#each vitals}}
        <div class="mm-vital {{key}}">
          <span class="mm-vital-label">{{label}}</span>
          <span class="mm-vital-fields">
            <input type="number" step="1" name="system.{{key}}.value" value="{{value}}" aria-label="{{label}}" {{#unless ../editable}}disabled{{/unless}}>
            <i aria-hidden="true">/</i>
            <input type="number" step="1" min="0" name="system.{{key}}.max" value="{{max}}" aria-label="{{label}} ({{localize 'MMRPG.Sheet.max'}})" {{#unless ../editable}}disabled{{/unless}}>
          </span>
        </div>
      {{/each}}
    </div>
  </div>
</header>
