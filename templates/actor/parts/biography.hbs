<section class="mmrpg-biography">
  <div class="mmrpg-detail-grid">
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.realName"}}</span><input type="text" name="system.details.realName" value="{{source.details.realName}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.gender"}}</span><input type="text" name="system.details.gender" value="{{source.details.gender}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.height"}}</span><input type="text" name="system.details.height" value="{{source.details.height}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.weight"}}</span><input type="text" name="system.details.weight" value="{{source.details.weight}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.eyes"}}</span><input type="text" name="system.details.eyes" value="{{source.details.eyes}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.hair"}}</span><input type="text" name="system.details.hair" value="{{source.details.hair}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field wide"><span>{{localize "MMRPG.Sheet.features"}}</span><input type="text" name="system.details.features" value="{{source.details.features}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.teams"}}</span><input type="text" name="system.details.teams" value="{{source.details.teams}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="mmrpg-field"><span>{{localize "MMRPG.Sheet.base"}}</span><input type="text" name="system.details.base" value="{{source.details.base}}" {{#unless editable}}disabled{{/unless}}></label>
  </div>
  <h4 class="mm-sub">{{localize "MMRPG.Sheet.biography"}}</h4>
  <prose-mirror name="system.biography" value="{{source.biography}}" toggled>{{{enriched.biography}}}</prose-mirror>
  <h4 class="mm-sub">{{localize "MMRPG.Sheet.personality"}}</h4>
  <prose-mirror name="system.personality" value="{{source.personality}}" toggled>{{{enriched.personality}}}</prose-mirror>
  <h4 class="mm-sub">{{localize "MMRPG.Sheet.notes"}}</h4>
  <prose-mirror name="system.notes" value="{{source.notes}}" toggled>{{{enriched.notes}}}</prose-mirror>
</section>
