<section class="mm-panel mm-damage">
  <h3>{{localize "MMRPG.Sheet.damage"}}</h3>
  <div class="mm-panel-body">
    {{#each damageRows}}
      <div class="mm-damage-row">
        <abbr title="{{label}}">{{abbr}}</abbr>
        <span class="mm-box marvel" title="{{localize 'MMRPG.Sheet.damageFormula'}}"><span class="mm-die-m">M</span><span>&times;{{multiplier}}</span></span>
        <span class="mm-plus">+</span>
        <span class="mm-box">{{score}}</span>
      </div>
    {{/each}}
  </div>
</section>
