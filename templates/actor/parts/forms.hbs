<p class="mmrpg-note-box">{{localize "MMRPG.Form.hint"}}</p>
{{#each formGroups}}
  <div class="mm-panel" data-form-kind="{{kind}}">
    <h3>{{label}}</h3>
    <div class="mm-panel-body">
      {{#if ../editable}}
        <div class="mmrpg-toolbar">
          <button type="button" class="mmrpg-wide-button" data-action="createItem" data-type="form" data-kind="{{kind}}">
            <i class="fa-solid fa-plus"></i> {{localize "MMRPG.Sheet.add"}}
          </button>
        </div>
      {{/if}}
      {{#if items.length}}
        <ul class="mmrpg-item-list">
          {{#each items}}
            <li class="mmrpg-entry mmrpg-form {{#if active}}is-active{{/if}}" data-item-id="{{id}}" data-search="{{search}}">
              <div class="mmrpg-entry-head">
                <img class="mmrpg-entry-icon" src="{{img}}" alt="">
                <div class="mmrpg-entry-title">
                  <button type="button" class="mmrpg-entry-name" data-action="editItem" data-item-id="{{id}}">{{name}}</button>
                  <div class="mmrpg-badges">
                    {{#if active}}<span class="mmrpg-chip active">{{localize "MMRPG.Form.active"}}</span>{{/if}}
                    {{#if borrowed}}<span class="mmrpg-chip warn">{{localize "MMRPG.Form.borrowed"}}</span>{{/if}}
                    {{#each badges}}<span class="mmrpg-chip">{{this}}</span>{{/each}}
                  </div>
                </div>
                <div class="mmrpg-entry-controls">
                  <button type="button" class="mmrpg-roll-button small mmrpg-form-toggle {{#if active}}is-on{{/if}}" data-action="toggleForm" data-item-id="{{id}}" {{#unless ../../editable}}disabled{{/unless}}>
                    {{#if active}}{{localize "MMRPG.Form.deactivate"}}{{else}}{{localize "MMRPG.Form.activate"}}{{/if}}
                  </button>
                  <button type="button" class="mmrpg-icon-button" data-action="editItem" data-item-id="{{id}}" title="{{localize 'MMRPG.Sheet.edit'}}" aria-label="{{localize 'MMRPG.Sheet.edit'}}: {{name}}">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  {{#if ../../editable}}
                    <button type="button" class="mmrpg-icon-button" data-action="deleteItem" data-item-id="{{id}}" title="{{localize 'MMRPG.Sheet.delete'}}" aria-label="{{localize 'MMRPG.Sheet.delete'}}: {{name}}">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  {{/if}}
                </div>
              </div>
              {{#if hasDescription}}
                <details class="mmrpg-entry-desc" data-item-id="{{id}}" {{#if descriptionOpen}}open{{/if}}>
                  <summary>
                    <i class="fa-solid fa-chevron-right mmrpg-chevron" aria-hidden="true"></i>
                    <span class="mmrpg-excerpt">{{excerpt}}</span>
                    <span class="mmrpg-more"><span class="more">{{localize "MMRPG.Sheet.readMore"}}</span><span class="less">{{localize "MMRPG.Sheet.readLess"}}</span></span>
                  </summary>
                  <div class="mmrpg-prose">{{{descriptionHtml}}}</div>
                </details>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="mmrpg-empty">{{localize "MMRPG.Form.empty"}}</p>
      {{/if}}
    </div>
  </div>
{{/each}}
