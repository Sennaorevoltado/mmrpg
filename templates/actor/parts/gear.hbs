<div class="mm-panel">
  <h3>{{localize "MMRPG.Tabs.gear"}}</h3>
  <div class="mm-panel-body">
    <div class="mmrpg-toolbar">
      <label class="mmrpg-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" data-filter value="{{filter}}" placeholder="{{localize 'MMRPG.Sheet.filterGear'}}" aria-label="{{localize 'MMRPG.Sheet.filterGear'}}">
      </label>
    </div>
    {{> "systems/mmrpg/templates/actor/parts/items.hbs" list=weapons type="weapon" title=(localize "MMRPG.Sheet.weapons") showEquip=true}}
    {{> "systems/mmrpg/templates/actor/parts/items.hbs" list=gear type="gear" title=(localize "MMRPG.Sheet.gear") showEquip=true}}
  </div>
</div>
