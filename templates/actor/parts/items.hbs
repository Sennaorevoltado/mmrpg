<section class="mmrpg-item-section" data-section="{{type}}">
  <header class="mmrpg-section-head">
    <h4>{{title}}<small>{{list.length}}</small></h4>
    {{#if editable}}
      <button type="button" class="mmrpg-icon-button" data-action="createItem" data-type="{{type}}" {{#if powerSet}}data-power-set="{{powerSet}}"{{/if}} title="{{localize 'MMRPG.Sheet.add'}}: {{title}}" aria-label="{{localize 'MMRPG.Sheet.add'}}: {{title}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    {{/if}}
  </header>
  {{#if list.length}}
    <ul class="mmrpg-item-list">
      {{#each list}}
        {{> "systems/mmrpg/templates/actor/parts/entry.hbs" showEquip=../showEquip editable=../editable}}
      {{/each}}
    </ul>
  {{else}}
    <p class="mmrpg-empty">{{localize "MMRPG.Sheet.empty"}}</p>
  {{/if}}
</section>
