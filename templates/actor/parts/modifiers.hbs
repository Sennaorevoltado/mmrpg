<section class="mmrpg-modifiers">
  <p class="mmrpg-muted">{{localize "MMRPG.Sheet.modifiersHint"}}</p>
  <table>
    <thead>
      <tr>
        <th></th>
        <th>{{localize "MMRPG.Sheet.defense"}}</th>
        <th>{{localize "MMRPG.Sheet.attack"}}</th>
        <th>{{localize "MMRPG.Sheet.damage"}}</th>
        <th>{{localize "MMRPG.Sheet.noncombat"}}</th>
        <th>{{localize "MMRPG.Sheet.multiplier"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each abilities}}
        <tr>
          <th>{{label}}</th>
          <td><input type="number" name="system.abilities.{{key}}.defenseBonus" value="{{source.defenseBonus}}" step="1" {{#unless ../editable}}disabled{{/unless}}></td>
          <td><input type="number" name="system.abilities.{{key}}.attackBonus" value="{{source.attackBonus}}" step="1" {{#unless ../editable}}disabled{{/unless}}></td>
          <td><input type="number" name="system.abilities.{{key}}.damageBonus" value="{{source.damageBonus}}" step="1" {{#unless ../editable}}disabled{{/unless}}></td>
          <td><input type="number" name="system.abilities.{{key}}.noncomBonus" value="{{source.noncomBonus}}" step="1" {{#unless ../editable}}disabled{{/unless}}></td>
          <td><input type="number" name="system.abilities.{{key}}.multiplierBonus" value="{{source.multiplierBonus}}" step="1" {{#unless ../editable}}disabled{{/unless}}></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <div class="mmrpg-header-row">
    <label class="mmrpg-field inline">
      <span>{{localize "MMRPG.Sheet.initiativeBonus"}}</span>
      <input type="number" name="system.init.bonus" value="{{source.init.bonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="mmrpg-field inline">
      <input type="checkbox" name="system.init.edge" {{#if source.init.edge}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
      <span>{{localize "MMRPG.Edge.edge"}}</span>
    </label>
    <label class="mmrpg-field inline">
      <input type="checkbox" name="system.init.trouble" {{#if source.init.trouble}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
      <span>{{localize "MMRPG.Edge.trouble"}}</span>
    </label>
  </div>
</section>
