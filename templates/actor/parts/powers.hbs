<div class="mm-panel">
  <h3>{{localize "MMRPG.Tabs.powers"}}</h3>
  <div class="mm-panel-body">
    <div class="mmrpg-toolbar">
      <label class="mmrpg-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" data-filter value="{{filter}}" placeholder="{{localize 'MMRPG.Sheet.filterPowers'}}" aria-label="{{localize 'MMRPG.Sheet.filterPowers'}}">
      </label>
      {{#if editable}}
        <button type="button" class="mmrpg-wide-button" data-action="createItem" data-type="power">
          <i class="fa-solid fa-plus"></i> {{localize "MMRPG.Sheet.addPower"}}
        </button>
      {{/if}}
      <button type="button" class="mmrpg-wide-button" data-action="resetUses">
        <i class="fa-solid fa-rotate-left"></i> {{localize "MMRPG.Sheet.resetUses"}}
      </button>
    </div>
    {{#each powerGroups}}
      {{> "systems/mmrpg/templates/actor/parts/items.hbs" list=items type="power" title=label powerSet=key showEquip=false editable=../editable}}
    {{else}}
      <p class="mmrpg-empty">{{localize "MMRPG.Sheet.noPowers"}}</p>
    {{/each}}
  </div>
</div>
