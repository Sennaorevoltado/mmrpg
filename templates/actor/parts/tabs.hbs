<nav class="mm-tabs" role="tablist" aria-label="{{localize 'MMRPG.Sheet.sections'}}">
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="main">{{localize "MMRPG.Tabs.main"}}</button>
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="powers">{{localize "MMRPG.Tabs.powers"}}</button>
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="traits">{{localize "MMRPG.Tabs.traits"}}</button>
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="gear">{{localize "MMRPG.Tabs.gear"}}</button>
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="forms">{{localize "MMRPG.Tabs.forms"}}{{#if activeForms.length}} ({{activeForms.length}}){{/if}}</button>
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="effects">{{localize "MMRPG.Tabs.effects"}}</button>
  <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="mods">{{localize "MMRPG.Tabs.mods"}}</button>
  {{#if isCharacter}}
    <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="bio">{{localize "MMRPG.Tabs.bio"}}</button>
  {{else}}
    <button type="button" class="mm-tab" role="tab" data-action="switchTab" data-tab="notes">{{localize "MMRPG.Tabs.notes"}}</button>
  {{/if}}
</nav>
