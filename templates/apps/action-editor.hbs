{{#if missing}}
  <p class="mmrpg-empty">{{localize "MMRPG.ActionEditor.missing"}}</p>
{{else}}
<div class="mmrpg-editor-body">

  <fieldset>
    <legend>{{localize "MMRPG.ActionEditor.general"}}</legend>
    <div class="mmrpg-detail-grid">
      <label class="mmrpg-field wide">
        <span>{{localize "MMRPG.Action.name"}}</span>
        <input type="text" name="name" value="{{a.name}}" placeholder="{{localize 'MMRPG.Action.nameHint'}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.activation"}}</span>
        <select name="activation" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions activationOptions a.activation}}</select>
      </label>
      <label class="mmrpg-field wide">
        <span>{{localize "MMRPG.Action.description"}}</span>
        <textarea name="description" rows="3" {{#unless editable}}disabled{{/unless}}>{{a.description}}</textarea>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "MMRPG.ActionEditor.targeting"}}</legend>
    <div class="mmrpg-detail-grid">
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.targetType"}}</span>
        <select name="target.type" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions targetTypeOptions a.target.type}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.targetCount"}}</span>
        <input type="number" name="target.count" value="{{a.target.count}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.rangeText"}}</span>
        <input type="text" name="target.range" value="{{a.target.range}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.rangeDistance"}}</span>
        <input type="number" name="target.distance" value="{{a.target.distance}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.areaShape"}}</span>
        <select name="area.shape" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions areaShapeOptions a.area.shape}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.areaSize"}}</span>
        <input type="number" name="area.size" value="{{a.area.size}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "MMRPG.ActionEditor.roll"}}</legend>
    <div class="mmrpg-detail-grid">
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.rollMode"}}</span>
        <select name="roll.mode" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions rollModeOptions a.roll.mode}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.rollAbility"}}</span>
        <select name="roll.ability" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions abilityOptions a.roll.ability}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.attackKind"}}</span>
        <select name="roll.kind" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions attackKindOptions a.roll.kind}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.targetDefense"}}</span>
        <select name="roll.targetDefense" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions abilityOptions a.roll.targetDefense}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.difficulty"}}</span>
        <input type="number" name="roll.difficulty" value="{{a.roll.difficulty}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.rollBonus"}}</span>
        <input type="number" name="roll.bonus" value="{{a.roll.bonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.edge"}}</span>
        <select name="roll.edge" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions edgeOptions a.roll.edge}}</select>
      </label>
    </div>
    <p class="hint">{{localize "MMRPG.ActionEditor.rollHint"}}</p>
  </fieldset>

  <fieldset>
    <legend>
      <label class="mmrpg-field inline">
        <input type="checkbox" name="damage.enabled" {{#if a.damage.enabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "MMRPG.Action.damage"}}</span>
      </label>
    </legend>
    <div class="mmrpg-detail-grid">
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.damageAbility"}}</span>
        <select name="damage.ability" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions optionalAbilityOptions a.damage.ability}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.multiplierBonus"}}</span>
        <input type="number" name="damage.multiplierBonus" value="{{a.damage.multiplierBonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.flat"}}</span>
        <input type="number" name="damage.flat" value="{{a.damage.flat}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.damageResource"}}</span>
        <select name="damage.resource" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions damageResourceOptions a.damage.resource}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.element"}}</span>
        <select name="damage.element" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions elementOptions a.damage.element}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.damageWhen"}}</span>
        <select name="damage.when" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions damageWhenOptions a.damage.when}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.reductionFrom"}}</span>
        <select name="damage.reductionFrom" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions reductionFromOptions a.damage.reductionFrom}}</select>
      </label>
      <label class="mmrpg-field inline">
        <input type="checkbox" name="damage.ignoreReduction" {{#if a.damage.ignoreReduction}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "MMRPG.Action.ignoreReduction"}}</span>
      </label>
      <label class="mmrpg-field" title="{{localize 'MMRPG.Action.perFocusHint'}}">
        <span>{{localize "MMRPG.Action.perFocus"}}</span>
        <input type="number" name="damage.perFocus" value="{{a.damage.perFocus}}" min="0" step="0.5" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field" title="{{localize 'MMRPG.Action.damageScaleHint'}}">
        <span>{{localize "MMRPG.Action.damageScale"}}</span>
        <input type="number" name="damage.scale" value="{{a.damage.scale}}" min="0" step="0.25" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.fantasticFactor"}}</span>
        <input type="number" name="damage.fantasticFactor" value="{{a.damage.fantasticFactor}}" min="1" step="0.5" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>
      <label class="mmrpg-field inline">
        <input type="checkbox" name="healing.enabled" {{#if a.healing.enabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "MMRPG.Action.healing"}}</span>
      </label>
    </legend>
    <div class="mmrpg-detail-grid">
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.healingMode"}}</span>
        <select name="healing.mode" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions healingModeOptions a.healing.mode}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.healingResource"}}</span>
        <select name="healing.resource" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions healingResourceOptions a.healing.resource}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.healingTarget"}}</span>
        <select name="healing.target" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions healingTargetOptions a.healing.target}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.damageAbility"}}</span>
        <select name="healing.ability" {{#unless editable}}disabled{{/unless}}>{{mmrpgOptions optionalAbilityOptions a.healing.ability}}</select>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.multiplierBonus"}}</span>
        <input type="number" name="healing.multiplierBonus" value="{{a.healing.multiplierBonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.flat"}}</span>
        <input type="number" name="healing.flat" value="{{a.healing.flat}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field" title="{{localize 'MMRPG.Action.perFocusHint'}}">
        <span>{{localize "MMRPG.Action.perFocus"}}</span>
        <input type="number" name="healing.perFocus" value="{{a.healing.perFocus}}" min="0" step="0.5" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "MMRPG.Action.effects"}}</legend>
    {{#each a.effects}}
      <div class="mmrpg-effect-block">
        <input type="hidden" name="effects.{{@index}}.id" value="{{id}}">
        <div class="mmrpg-detail-grid">
          <label class="mmrpg-field">
            <span>{{localize "MMRPG.Action.effectName"}}</span>
            <input type="text" name="effects.{{@index}}.name" value="{{name}}" {{#unless ../editable}}disabled{{/unless}}>
          </label>
          <label class="mmrpg-field">
            <span>{{localize "MMRPG.Action.effectWhen"}}</span>
            <select name="effects.{{@index}}.when" {{#unless ../editable}}disabled{{/unless}}>{{mmrpgOptions ../triggerOptions when}}</select>
          </label>
          <label class="mmrpg-field">
            <span>{{localize "MMRPG.Action.effectTarget"}}</span>
            <select name="effects.{{@index}}.target" {{#unless ../editable}}disabled{{/unless}}>{{mmrpgOptions ../effectTargetOptions target}}</select>
          </label>
          <label class="mmrpg-field">
            <span>{{localize "MMRPG.Action.effectStatus"}}</span>
            <select name="effects.{{@index}}.status" {{#unless ../editable}}disabled{{/unless}}>{{mmrpgOptions ../statusOptions status}}</select>
          </label>
          <label class="mmrpg-field">
            <span>{{localize "MMRPG.Action.effectRounds"}}</span>
            <input type="number" name="effects.{{@index}}.rounds" value="{{rounds}}" min="0" step="1" {{#unless ../editable}}disabled{{/unless}}>
          </label>
          <label class="mmrpg-field wide">
            <span>{{localize "MMRPG.Action.effectNote"}}</span>
            <input type="text" name="effects.{{@index}}.note" value="{{note}}" {{#unless ../editable}}disabled{{/unless}}>
          </label>
        </div>

        <div class="mmrpg-changes">
          <div class="mmrpg-section-head">
            <strong>{{localize "MMRPG.Action.effectChanges"}}</strong>
            {{#if ../editable}}
              <button type="button" class="mmrpg-icon-button" data-action="addChange" data-index="{{@index}}" title="{{localize 'MMRPG.Sheet.add'}}">
                <i class="fa-solid fa-plus"></i>
              </button>
            {{/if}}
          </div>
          {{#each changes}}
            <div class="mmrpg-change-row">
              <input type="text" name="effects.{{@../index}}.changes.{{@index}}.key" value="{{key}}" placeholder="system.abilities.mle.value" {{#unless ../../editable}}disabled{{/unless}}>
              <select name="effects.{{@../index}}.changes.{{@index}}.type" {{#unless ../../editable}}disabled{{/unless}}>{{mmrpgOptions ../../changeTypeOptions type}}</select>
              <input type="text" name="effects.{{@../index}}.changes.{{@index}}.value" value="{{value}}" {{#unless ../../editable}}disabled{{/unless}}>
              {{#if ../../editable}}
                <button type="button" class="mmrpg-icon-button" data-action="removeChange" data-effect="{{@../index}}" data-index="{{@index}}" title="{{localize 'MMRPG.Sheet.delete'}}">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              {{/if}}
            </div>
          {{/each}}
        </div>

        {{#if ../editable}}
          <button type="button" class="mmrpg-wide-button danger" data-action="removeEffect" data-index="{{@index}}">
            <i class="fa-solid fa-trash"></i> {{localize "MMRPG.Action.removeEffect"}}
          </button>
        {{/if}}
      </div>
    {{else}}
      <p class="mmrpg-empty">{{localize "MMRPG.Action.noEffects"}}</p>
    {{/each}}
    {{#if editable}}
      <button type="button" class="mmrpg-wide-button" data-action="addEffect">
        <i class="fa-solid fa-plus"></i> {{localize "MMRPG.Action.addEffect"}}
      </button>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "MMRPG.ActionEditor.cost"}}</legend>
    <div class="mmrpg-detail-grid">
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Resource.focus"}}</span>
        <input type="number" name="cost.focus" value="{{a.cost.focus}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field inline" title="{{localize 'MMRPG.Action.scalableHint'}}">
        <input type="checkbox" name="cost.scalable" {{#if a.cost.scalable}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "MMRPG.Action.scalable"}}</span>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Resource.karma"}}</span>
        <input type="number" name="cost.karma" value="{{a.cost.karma}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Resource.health"}}</span>
        <input type="number" name="cost.health" value="{{a.cost.health}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.usesValue"}}</span>
        <input type="number" name="uses.value" value="{{a.uses.value}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="mmrpg-field">
        <span>{{localize "MMRPG.Action.usesMax"}}</span>
        <input type="number" name="uses.max" value="{{a.uses.max}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
    <p class="hint">{{localize "MMRPG.ActionEditor.usesHint"}}</p>
  </fieldset>
</div>
{{/if}}
