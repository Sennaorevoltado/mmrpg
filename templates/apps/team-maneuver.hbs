<div class="mmrpg-team-body">
  <p class="mmrpg-muted">{{localize "MMRPG.TeamManeuver.intro"}}</p>
  <div class="mmrpg-detail-grid">
    <label class="mmrpg-field">
      <span>{{localize "MMRPG.TeamManeuver.type"}}</span>
      <select name="type">{{mmrpgOptions typeOptions type}}</select>
    </label>
    <label class="mmrpg-field">
      <span>{{localize "MMRPG.TeamManeuver.level"}}</span>
      <select name="level">{{mmrpgOptions levelOptions level}}</select>
    </label>
  </div>
  <h3>{{localize "MMRPG.TeamManeuver.members"}}</h3>
  <ul class="mmrpg-member-list">
    {{#each members}}
      <li class="{{#unless enough}}is-short{{/unless}}">
        <img src="{{img}}" alt="">
        <span>{{name}}</span>
        <span class="mmrpg-muted">{{localize "MMRPG.Resource.focus"}} {{focus}}</span>
      </li>
    {{else}}
      <li class="mmrpg-empty">{{localize "MMRPG.Warn.selectToken"}}</li>
    {{/each}}
  </ul>
  <button type="button" class="mmrpg-wide-button" data-action="use">
    <i class="fa-solid fa-people-group"></i> {{localize "MMRPG.TeamManeuver.use" cost=cost}}
  </button>
</div>
