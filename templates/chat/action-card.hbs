<div class="mmrpg-card mmrpg-action-card{{#if locked}} is-locked{{/if}}">
  <header class="mmrpg-card-header">
    <img src="{{item.img}}" alt="">
    <div>
      <h3>{{title}}</h3>
      <span class="mmrpg-muted">{{actor.name}} · {{localize activation}}</span>
    </div>
  </header>

  <div class="mmrpg-card-tags">
    {{#if element}}<span class="mmrpg-chip element">{{localize element.label}}</span>{{/if}}
    {{#each costs}}<span class="mmrpg-chip cost">{{amount}} {{localize label}}</span>{{/each}}
    {{#if uses}}<span class="mmrpg-chip">{{localize "MMRPG.Card.uses"}} {{uses.value}}/{{uses.max}}</span>{{/if}}
  </div>

  {{#if description}}<div class="mmrpg-card-description">{{{description}}}</div>{{/if}}

  {{#if rolled}}
    <div class="mmrpg-card-roll">
      <div class="mmrpg-card-roll-title">
        {{localize abilityLabel}}
        {{#if isAttack}}<span class="mmrpg-muted">{{localize "MMRPG.Card.against"}} {{localize targetDefenseLabel}}</span>{{/if}}
        {{#if isCheck}}{{#if check.difficulty}}<span class="mmrpg-muted">{{localize "MMRPG.Card.difficulty"}} {{check.difficulty}}</span>{{/if}}{{/if}}
      </div>
      {{> "systems/mmrpg/templates/dice/roll.hbs" roll}}
      {{#if isCheck}}{{#if check.difficulty}}
        <div class="mmrpg-outcome {{#if check.success}}success{{else}}failure{{/if}}">
          {{#if check.success}}{{localize "MMRPG.Card.success"}}{{else}}{{localize "MMRPG.Card.failure"}}{{/if}}
        </div>
      {{/if}}{{/if}}
      {{#if elementFantasticApplies}}
        <div class="mmrpg-note">
          {{localize "MMRPG.Card.elementFantastic"}}: {{localize element.label}}
          {{#if elementStatus}}({{localize elementStatus}}){{/if}}
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if hasTargets}}
    <div class="mmrpg-targets">
      {{#each targets}}
        <div class="mmrpg-target {{#if hit}}hit{{else}}miss{{/if}}">
          <div class="mmrpg-target-head">
            {{#if img}}<img src="{{img}}" alt="">{{/if}}
            <strong>{{name}}</strong>
            {{#if defense}}
              <span class="mmrpg-muted">{{localize "MMRPG.Card.defense"}} {{defense}}</span>
            {{/if}}
            <span class="mmrpg-outcome {{#if hit}}success{{else}}failure{{/if}}">
              {{#if hit}}{{localize "MMRPG.Card.hit"}}{{else}}{{localize "MMRPG.Card.miss"}}{{/if}}
            </span>
          </div>

          {{#if damage}}
            <div class="mmrpg-line damage">
              <span class="mmrpg-amount">{{damage.amount}}</span>
              <span>{{localize "MMRPG.Card.damageTo"}} {{damage.resourceLabel}}</span>
              <span class="mmrpg-calc">
                {{damage.marvelValue}} × {{damage.multiplier}} + {{damage.additive}}{{#if damage.scaleLabel}} × {{damage.scaleLabel}}{{/if}}{{#if damage.doubled}} × 2{{/if}}
                {{#if damage.reduction}}({{localize "MMRPG.Card.reduction"}} {{damage.reduction}}){{/if}}
              </span>
              {{#if applied.damage}}<i class="fa-solid fa-check mmrpg-done" title="{{localize 'MMRPG.Card.applied'}}"></i>{{/if}}
            </div>
          {{/if}}
          {{#if healing}}
            <div class="mmrpg-line healing">
              <span class="mmrpg-amount">{{healing.amount}}</span>
              <span>{{localize "MMRPG.Card.healTo"}} {{healing.resourceLabel}}</span>
              {{#if applied.healing}}<i class="fa-solid fa-check mmrpg-done" title="{{localize 'MMRPG.Card.applied'}}"></i>{{/if}}
            </div>
          {{/if}}
          {{#each effects}}
            <div class="mmrpg-line effect"><i class="fa-solid fa-wand-sparkles"></i> {{label}}</div>
          {{/each}}
          {{#if effects.length}}
            {{#if applied.effects}}<i class="fa-solid fa-check mmrpg-done" title="{{localize 'MMRPG.Card.applied'}}"></i>{{/if}}
          {{/if}}

          {{#if pending}}
            <div class="mmrpg-buttons" data-mmrpg-control>
              <button type="button" data-mmrpg-action="apply-target" data-index="{{index}}">
                <i class="fa-solid fa-bullseye"></i> {{localize "MMRPG.Card.apply"}}
              </button>
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  {{else}}
    {{#if preview}}
      <div class="mmrpg-target preview">
        <div class="mmrpg-line damage">
          <span class="mmrpg-amount">{{preview.amount}}</span>
          <span>{{localize "MMRPG.Card.damageTo"}} {{preview.resourceLabel}}</span>
          <span class="mmrpg-calc">{{preview.marvelValue}} × {{preview.multiplier}} + {{preview.additive}}{{#if preview.scaleLabel}} × {{preview.scaleLabel}}{{/if}}{{#if preview.doubled}} × 2{{/if}}</span>
        </div>
        <p class="mmrpg-muted">{{localize "MMRPG.Card.noTargets"}}</p>
      </div>
    {{/if}}
  {{/if}}

  {{#if self.has}}
    <div class="mmrpg-target self">
      <div class="mmrpg-target-head">
        <strong>{{localize "MMRPG.Card.self"}}</strong>
      </div>
      {{#if self.healing}}
        <div class="mmrpg-line healing">
          <span class="mmrpg-amount">{{self.healing.amount}}</span>
          <span>{{localize "MMRPG.Card.healTo"}} {{self.healing.resourceLabel}}</span>
          {{#if self.applied.healing}}<i class="fa-solid fa-check mmrpg-done" title="{{localize 'MMRPG.Card.applied'}}"></i>{{/if}}
        </div>
      {{/if}}
      {{#each self.effects}}
        <div class="mmrpg-line effect"><i class="fa-solid fa-wand-sparkles"></i> {{label}}</div>
      {{/each}}
      {{#if self.pending}}
        <div class="mmrpg-buttons" data-mmrpg-control>
          <button type="button" data-mmrpg-action="apply-self">
            <i class="fa-solid fa-user"></i> {{localize "MMRPG.Card.apply"}}
          </button>
        </div>
      {{/if}}
    </div>
  {{/if}}

  <footer class="mmrpg-card-footer" data-mmrpg-control>
    {{#if isArea}}
      <button type="button" data-mmrpg-action="place-template">
        <i class="fa-solid fa-draw-polygon"></i> {{localize "MMRPG.Card.placeTemplate"}}
      </button>
    {{/if}}
    {{#if hasTargets}}
      <button type="button" data-mmrpg-action="apply-all">
        <i class="fa-solid fa-check-double"></i> {{localize "MMRPG.Card.applyAll"}}
      </button>
    {{/if}}
  </footer>
</div>
