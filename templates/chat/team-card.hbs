<div class="mmrpg-card mmrpg-team-card">
  <header class="mmrpg-card-header">
    <i class="fa-solid fa-people-group mmrpg-card-icon"></i>
    <div>
      <h3>{{name}}</h3>
      <span class="mmrpg-muted">{{localize "MMRPG.TeamManeuver.card" level=level cost=cost}}</span>
    </div>
  </header>
  <p class="mmrpg-muted">{{localize "MMRPG.TeamManeuver.cardRank" min=rankMin max=rankMax}}</p>
  <ul class="mmrpg-member-list">
    {{#each members}}
      <li><img src="{{img}}" alt=""> {{name}}</li>
    {{/each}}
  </ul>
</div>
