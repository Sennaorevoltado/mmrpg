<div class="marvel-multiverse dice-roll marvel-roll">
    <div class="dice-result">
        <div class="dice-formula"><span>{{formula}}</span></div>
        {{{tooltip}}}
        <h4 class="dice-total"><span>{{total}}</span></h4>
        <button type="button" class="damage" title="{{localize 'MARVEL_MULTIVERSE.Damage.title'}}">
            <span>{{localize "MARVEL_MULTIVERSE.Damage.button"}}</span>
        </button>
    </div>
</div>
