<div class="mm-panel mmrpg-actions-list">
  <h3>{{localize "MMRPG.Tabs.actions"}}</h3>
  <div class="mm-panel-body">
    <p class="mmrpg-muted">{{localize "MMRPG.Action.hint"}}</p>
    {{#if editable}}
      <div class="mmrpg-toolbar">
        <button type="button" class="mmrpg-wide-button" data-action="addAction">
          <i class="fa-solid fa-plus"></i> {{localize "MMRPG.Action.add"}}
        </button>
      </div>
    {{/if}}
    {{#if actions.length}}
      <ul class="mmrpg-item-list">
        {{#each actions}}
          <li class="mmrpg-item">
            <div class="mmrpg-item-main">
              <div class="mmrpg-item-title">
                <button type="button" class="mmrpg-entry-name" data-action="editAction" data-action-id="{{id}}">{{label}}</button>
                <span class="mmrpg-muted">{{activation}}</span>
              </div>
              <div class="mmrpg-badges">
                <span class="mmrpg-chip">{{rollSummary}}</span>
                {{#if damage}}<span class="mmrpg-chip">{{localize "MMRPG.Action.damage"}}</span>{{/if}}
                {{#if healing}}<span class="mmrpg-chip">{{localize "MMRPG.Action.healing"}}</span>{{/if}}
                {{#if effects}}<span class="mmrpg-chip">{{localize "MMRPG.Action.effects"}} {{effects}}</span>{{/if}}
                {{#if costs}}<span class="mmrpg-chip cost">{{costs}}</span>{{/if}}
                {{#if uses}}<span class="mmrpg-chip">{{localize "MMRPG.Card.uses"}} {{uses}}</span>{{/if}}
              </div>
            </div>
            <div class="mmrpg-item-controls">
              {{#if ../isEmbedded}}
                <button type="button" class="mmrpg-icon-button" data-action="useAction" data-action-id="{{id}}" title="{{localize 'MMRPG.Sheet.useAction'}}" aria-label="{{localize 'MMRPG.Sheet.useAction'}}: {{label}}">
                  <i class="fa-solid fa-bolt"></i>
                </button>
              {{/if}}
              <button type="button" class="mmrpg-icon-button" data-action="editAction" data-action-id="{{id}}" title="{{localize 'MMRPG.Sheet.edit'}}" aria-label="{{localize 'MMRPG.Sheet.edit'}}: {{label}}">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              {{#if ../editable}}
                <button type="button" class="mmrpg-icon-button" data-action="duplicateAction" data-action-id="{{id}}" title="{{localize 'MMRPG.Action.duplicate'}}" aria-label="{{localize 'MMRPG.Action.duplicate'}}: {{label}}">
                  <i class="fa-solid fa-copy"></i>
                </button>
                <button type="button" class="mmrpg-icon-button" data-action="removeAction" data-action-id="{{id}}" title="{{localize 'MMRPG.Sheet.delete'}}" aria-label="{{localize 'MMRPG.Sheet.delete'}}: {{label}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="mmrpg-empty">{{localize "MMRPG.Action.none"}}</p>
    {{/if}}
  </div>
</div>
