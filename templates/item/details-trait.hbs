<div class="mm-detail-grid">
  <label class="mm-field wide">
    <span>{{localize "MMRPG.Item.restriction"}}</span>
    <input type="text" name="system.restriction" value="{{source.restriction}}" {{#unless editable}}disabled{{/unless}}>
  </label>
  <label class="mmrpg-field inline">
    <input type="checkbox" name="system.multiple" {{#if source.multiple}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
    <span>{{localize "MMRPG.Item.multiple"}}</span>
  </label>
</div>
