<section class="mmrpg-effects">
  <header class="mmrpg-section-head">
    <h3>{{localize "MMRPG.Sheet.effects"}}</h3>
    {{#if editable}}
      <button type="button" class="mmrpg-icon-button" data-action="createEffect" title="{{localize 'MMRPG.Sheet.add'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    {{/if}}
  </header>
  <p class="mmrpg-muted">{{localize "MMRPG.Item.effectsHint"}}</p>
  {{#if effects.length}}
    <ul class="mmrpg-item-list">
      {{#each effects}}
        <li class="mmrpg-item {{#if disabled}}is-disabled{{/if}}">
          <img src="{{img}}" alt="">
          <div class="mmrpg-item-main">
            <div class="mmrpg-item-title">
              <span class="mmrpg-item-name">{{name}}</span>
              {{#if transfer}}<span class="mmrpg-chip">{{localize "MMRPG.Item.transfer"}}</span>{{/if}}
            </div>
          </div>
          <div class="mmrpg-item-controls">
            <button type="button" class="mmrpg-icon-button {{#unless disabled}}is-on{{/unless}}" data-action="toggleEffect" data-effect-id="{{id}}" title="{{localize 'MMRPG.Sheet.toggle'}}">
              <i class="fa-solid fa-power-off"></i>
            </button>
            <button type="button" class="mmrpg-icon-button" data-action="editEffect" data-effect-id="{{id}}" title="{{localize 'MMRPG.Sheet.edit'}}">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            {{#if ../editable}}
              <button type="button" class="mmrpg-icon-button" data-action="deleteEffect" data-effect-id="{{id}}" title="{{localize 'MMRPG.Sheet.delete'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="mmrpg-empty">{{localize "MMRPG.Sheet.empty"}}</p>
  {{/if}}
</section>
