<div class="mm-panel mmrpg-effects">
  <h3>{{localize "MMRPG.Sheet.effects"}}</h3>
  <div class="mm-panel-body">
    <p class="mmrpg-muted">{{localize "MMRPG.Item.effectsHint"}}</p>
    {{#if editable}}
      <div class="mmrpg-toolbar">
        <button type="button" class="mmrpg-wide-button" data-action="createEffect">
          <i class="fa-solid fa-plus"></i> {{localize "MMRPG.Sheet.add"}}
        </button>
      </div>
    {{/if}}
    {{#if effects.length}}
      <ul class="mmrpg-item-list">
        {{#each effects}}
          <li class="mmrpg-item {{#if disabled}}is-disabled{{/if}}">
            <img src="{{img}}" alt="">
            <div class="mmrpg-item-main">
              <div class="mmrpg-item-title">
                <span class="mmrpg-item-name">{{name}}</span>
                {{#if transfer}}<span class="mmrpg-chip">{{localize "MMRPG.Item.transfer"}}</span>{{/if}}
              </div>
            </div>
            <div class="mmrpg-item-controls">
              <button type="button" class="mmrpg-icon-button {{#unless disabled}}is-on{{/unless}}" data-action="toggleEffect" data-effect-id="{{id}}" title="{{localize 'MMRPG.Sheet.toggle'}}" aria-label="{{localize 'MMRPG.Sheet.toggle'}}: {{name}}">
                <i class="fa-solid fa-power-off"></i>
              </button>
              <button type="button" class="mmrpg-icon-button" data-action="editEffect" data-effect-id="{{id}}" title="{{localize 'MMRPG.Sheet.edit'}}" aria-label="{{localize 'MMRPG.Sheet.edit'}}: {{name}}">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              {{#if ../editable}}
                <button type="button" class="mmrpg-icon-button" data-action="deleteEffect" data-effect-id="{{id}}" title="{{localize 'MMRPG.Sheet.delete'}}" aria-label="{{localize 'MMRPG.Sheet.delete'}}: {{name}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="mmrpg-empty">{{localize "MMRPG.Sheet.empty"}}</p>
    {{/if}}
  </div>
</div>
