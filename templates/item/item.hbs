<div class="mmrpg-sheet item {{type}}">
  {{> "systems/mmrpg/templates/item/header.hbs"}}

  <nav class="mmrpg-tabs">
    <a data-action="switchTab" data-tab="description">{{localize "MMRPG.Tabs.description"}}</a>
    <a data-action="switchTab" data-tab="details">{{localize "MMRPG.Tabs.details"}}</a>
    {{#if hasActions}}<a data-action="switchTab" data-tab="actions">{{localize "MMRPG.Tabs.actions"}} ({{actions.length}})</a>{{/if}}
    <a data-action="switchTab" data-tab="effects">{{localize "MMRPG.Tabs.effects"}}</a>
  </nav>

  <div class="mmrpg-panels">
    <section class="mmrpg-panel" data-tab="description">
      {{> "systems/mmrpg/templates/item/description.hbs"}}
    </section>

    <section class="mmrpg-panel" data-tab="details">
      {{#if (eq type "power")}}{{> "systems/mmrpg/templates/item/details-power.hbs"}}{{/if}}
      {{#if (eq type "trait")}}{{> "systems/mmrpg/templates/item/details-trait.hbs"}}{{/if}}
      {{#if (eq type "tag")}}{{> "systems/mmrpg/templates/item/details-tag.hbs"}}{{/if}}
      {{#if (eq type "origin")}}{{> "systems/mmrpg/templates/item/details-origin.hbs"}}{{/if}}
      {{#if (eq type "occupation")}}{{> "systems/mmrpg/templates/item/details-occupation.hbs"}}{{/if}}
      {{#if (eq type "weapon")}}{{> "systems/mmrpg/templates/item/details-weapon.hbs"}}{{/if}}
      {{#if (eq type "gear")}}{{> "systems/mmrpg/templates/item/details-gear.hbs"}}{{/if}}
    </section>

    {{#if hasActions}}
      <section class="mmrpg-panel" data-tab="actions">
        {{> "systems/mmrpg/templates/item/actions.hbs"}}
      </section>
    {{/if}}

    <section class="mmrpg-panel" data-tab="effects">
      {{> "systems/mmrpg/templates/item/effects.hbs"}}
    </section>
  </div>
</div>
